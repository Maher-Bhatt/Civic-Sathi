# CivicSathi Production Environment Variables

# ========================================
# Frontend (Vercel)
# ========================================
# The URL of your deployed backend API (Render)
VITE_API_BASE_URL=https://civicsathi-backend.onrender.com

# ========================================
# Backend API (Render)
# ========================================
# The Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-super-db.neon.tech/civicsathi?sslmode=require

# The secret key for JWT token generation
SECRET_KEY=your_super_secret_jwt_key_here

# Officer API Key for bypassing standard auth in legacy integrations (if any)
OFFICER_API_KEY=your_officer_api_key_here

# Set to True for production
IS_PRODUCTION=True
