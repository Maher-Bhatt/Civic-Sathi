# Database
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# Environment
ENVIRONMENT=local

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081

# Security
OFFICER_API_KEY=change-me-to-secure-key
JWT_SECRET=change-me-to-a-long-random-secret

# Password reset delivery (set Brevo for email and/or MSG91 for SMS)
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Civic Sathi
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=

# ML Configuration
SENTENCE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.72
MIN_CLUSTER_SIZE=5
SYSTEMIC_WINDOW_DAYS=30

# Features
ENABLE_SEED_ENDPOINT=true

# Logging
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# SATHI SETU INTEROPERABILITY
# -------------------------------------------------------------------
SATHI_SETU_LOOKUP_KEY=your_secure_random_key_here
# SATHI_SETU_WEBHOOK_URL=http://localhost:8001/v1/applications/ingest

